{
  "name": "vista-coast",
  "version": "1.0.0",
  "description": "VISTA COAST - browser 3D open-world crime action game (three.js, TypeScript, PWA)",
  "main": "dist/index.html",
  "scripts": {
    "build": "node tools/build.mjs && cp assets/icon-*.png dist/",
